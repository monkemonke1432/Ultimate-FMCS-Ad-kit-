// ==/UserScript==
// (the anti-adblock is the appendix in this case)

(function() {
    'use strict';

    const SELECTOR = 'iframe, ins, .ad-container, [id*="google_ads"], [id*="div-gpt-ad"], [class*="ad-slot"]';

    // Anything matching this is a captcha widget, not an ad — never touch it
    const CAPTCHA_PATTERN = /recaptcha|hcaptcha|turnstile|cf-turnstile|cf-chl|challenge/i;

    const isCaptcha = (el) => {
        // Check the element itself and its ancestors for captcha fingerprints
        const haystack = [
            el.src, el.id, el.className, el.title,
            el.getAttribute && el.getAttribute('name')
        ].filter(Boolean).join(' ');

        if (CAPTCHA_PATTERN.test(haystack)) return true;

        // Also check if it's nested inside a known captcha container
        return !!el.closest('.g-recaptcha, .h-captcha, .cf-turnstile, [class*="captcha"], [id*="captcha"]');
    };

    const nuke = () => {
        document.querySelectorAll(SELECTOR).forEach(el => {
            if (el.dataset.nuked) return;
            if (isCaptcha(el)) return; // skip captchas entirely

            el.style.opacity = '0.01';
            el.style.pointerEvents = 'none';
            el.dataset.nuked = 'true';
        });
    };

    let debounceTimer = null;
    const scheduleNuke = () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(nuke, 150);
    };

    window.addEventListener('load', () => {
        setTimeout(() => {
            nuke();

            const observer = new MutationObserver(scheduleNuke);
            observer.observe(document.body, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ['style', 'class', 'id']
            });

            setInterval(nuke, 10000);
        }, 5000);
    });
})();
